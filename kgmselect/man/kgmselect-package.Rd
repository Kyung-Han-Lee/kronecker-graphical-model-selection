\name{kgmselect-package}
\alias{kgmselect}
\alias{kgmselect-package}
\title{kgmselect: profiled model selection for Kronecker graphical models}
\description{
Fits the normalised cyclic estimator along a regularisation path and selects
a candidate by EBIC at the normalised fit, scale-profiled EBIC or
relaxation-profiled EBIC, as described in Lee and Ha, "Model Selection in
Kronecker Graphical Models". Cross-validation, StARS and support-constrained
refitting are included for comparison.
}
